---
---
<!-- Dashboard Section -->
<section aria-labelledby="dashboard-title" class="mk-section">
	<div class="mk-shell">
		<h2
			id="dashboard-title"
			class="max-w-3xl text-balance font-display text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-4xl lg:text-5xl"
		>
			Panel de Control y Monitorización
		</h2>
		<p class="mt-4 max-w-2xl text-lg leading-relaxed text-text-secondary">
			Todo lo que necesitas para gestionar tu tienda
		</p>

		<div class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
			<article class="mk-card p-6">
				<span class="mk-icon-tile">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M3 17l6-6 4 4 7-7"></path>
						<path stroke-linecap="round" stroke-linejoin="round" d="M14 8h7v7"></path>
					</svg>
				</span>
				<h3 class="mt-5 font-display text-lg font-bold tracking-[-0.01em] text-text-primary">Ingresos</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-secondary">Estadísticas de ingresos en tiempo real</p>
			</article>

			<article class="mk-card p-6">
				<span class="mk-icon-tile">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="9.5" cy="7.5" r="3.5"></circle>
						<path stroke-linecap="round" d="M3 20v-1a4 4 0 0 1 4-4h5a4 4 0 0 1 4 4v1"></path>
						<path stroke-linecap="round" d="M17 4.5a3.5 3.5 0 0 1 0 7"></path>
					</svg>
				</span>
				<h3 class="mt-5 font-display text-lg font-bold tracking-[-0.01em] text-text-primary">Visitantes</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-secondary">Seguimiento de tráfico</p>
			</article>

			<article class="mk-card p-6">
				<span class="mk-icon-tile">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 7.5l8 4.5 8-4.5M12 12v9"></path>
					</svg>
				</span>
				<h3 class="mt-5 font-display text-lg font-bold tracking-[-0.01em] text-text-primary">Pedidos activos</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-secondary">Gestión simplificada</p>
			</article>

			<article class="mk-card p-6">
				<span class="mk-icon-tile">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M3 6h10v10H3z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" d="M13 10h4l3 3v3h-7"></path>
						<circle cx="7" cy="18" r="1.8"></circle>
						<circle cx="17" cy="18" r="1.8"></circle>
					</svg>
				</span>
				<h3 class="mt-5 font-display text-lg font-bold tracking-[-0.01em] text-text-primary">Gestión de envíos</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-secondary">Control total de entregas</p>
			</article>
		</div>
	</div>
</section>
