---
---
<!-- Dashboard Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-16">
			<h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">Panel de Control y Monitorización</h2>
			<p class="text-xl text-text-secondary">Todo lo que necesitas para gestionar tu tienda</p>
		</div>
		<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
			<div class="p-6 bg-bg-card rounded-2xl border border-border-color shadow-card">
				<div class="text-primary-mint text-2xl mb-2">💰</div>
				<h3 class="text-lg font-bold text-text-primary mb-2">Ingresos</h3>
				<p class="text-text-secondary text-sm">Estadísticas de ingresos en tiempo real</p>
			</div>
			<div class="p-6 bg-bg-card rounded-2xl border border-border-color shadow-card">
				<div class="text-secondary-blue text-2xl mb-2">👥</div>
				<h3 class="text-lg font-bold text-text-primary mb-2">Visitantes</h3>
				<p class="text-text-secondary text-sm">Seguimiento de tráfico</p>
			</div>
			<div class="p-6 bg-bg-card rounded-2xl border border-border-color shadow-card">
				<div class="text-secondary-purple text-2xl mb-2">📦</div>
				<h3 class="text-lg font-bold text-text-primary mb-2">Pedidos activos</h3>
				<p class="text-text-secondary text-sm">Gestión simplificada</p>
			</div>
			<div class="p-6 bg-bg-card rounded-2xl border border-border-color shadow-card">
				<div class="text-accent-star text-2xl mb-2">🚚</div>
				<h3 class="text-lg font-bold text-text-primary mb-2">Gestión de envíos</h3>
				<p class="text-text-secondary text-sm">Control total de entregas</p>
			</div>
		</div>
	</div>
</section>
