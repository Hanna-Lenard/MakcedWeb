---
import { DEFAULT_STORE_SLUG, SIGNUP_URL, STORE_DOMAIN_SUFFIX } from '../../config/site';
---

<!-- Hero Section -->
<section
	id="inicio"
	aria-labelledby="hero-title"
	class="relative isolate overflow-hidden pt-[calc(var(--nav-h)+2.5rem)] pb-16 sm:pb-20 lg:pt-[calc(var(--nav-h)+4rem)] lg:pb-28"
>
	<!-- Fondo: una luz mint muy contenida y una línea de escaparate -->
	<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
		<div class="mk-wash absolute inset-0"></div>
		<div class="mk-shelf absolute inset-x-0 bottom-0 h-px"></div>
	</div>

	<div class="mk-shell">
		<div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
			<!-- Columna izquierda -->
			<div class="lg:col-span-5">
				<h1
					id="hero-title"
					class="mk-rise text-balance font-display text-[2.55rem] font-bold leading-[1.04] tracking-[-0.03em] text-text-primary sm:text-[3.25rem] lg:text-[3.55rem] xl:text-[3.9rem]"
				>
					Lanza la tienda online de tus sueños.<br class="sm:hidden" />
					<span class="whitespace-nowrap text-mint-ink">¡Hoy mismo!</span>
				</h1>

				<p
					class="mk-rise mt-6 max-w-xl text-lg leading-relaxed text-text-secondary sm:text-xl"
					style="animation-delay: 120ms"
				>
					Democratizamos el e-commerce. Crea, gestiona y escala tu negocio sin tocar una sola línea de código.
				</p>

				<!-- Dominio: solo vista previa, sin comprobación de disponibilidad -->
				<div class="mk-rise mt-8" style="animation-delay: 180ms">
					<label for="store-slug" class="text-sm font-semibold text-text-primary">Tu dirección web</label>
					<div
						class="mt-2 flex flex-col gap-2 rounded-2xl border border-border-color bg-surface-raised p-2 shadow-card transition-[border-color,box-shadow] focus-within:border-mint-ink focus-within:ring-4 focus-within:ring-primary-mint/20 sm:flex-row sm:items-center sm:rounded-[14px] sm:p-1.5"
					>
						<div class="flex min-w-0 flex-1 items-center gap-2 px-2 sm:px-3">
							<svg
								class="h-5 w-5 shrink-0 text-text-secondary"
								fill="none"
								stroke="currentColor"
								stroke-width="1.6"
								viewBox="0 0 24 24"
								aria-hidden="true"
							>
								<circle cx="12" cy="12" r="9"></circle>
								<path d="M3.6 9h16.8M3.6 15h16.8M12 3c2.4 2.5 3.6 5.5 3.6 9s-1.2 6.5-3.6 9c-2.4-2.5-3.6-5.5-3.6-9S9.6 5.5 12 3z"></path>
							</svg>
							<input
								id="store-slug"
								type="text"
								inputmode="url"
								autocomplete="off"
								autocapitalize="off"
								spellcheck="false"
								maxlength="30"
								placeholder={DEFAULT_STORE_SLUG}
								class="min-w-0 flex-1 bg-transparent py-2.5 text-[0.95rem] text-text-primary placeholder:text-text-secondary focus:outline-none"
								aria-describedby="store-slug-help store-slug-suffix"
							/>
							<span class="shrink-0 font-mono text-[0.78rem] text-text-secondary sm:text-sm" aria-hidden="true">
								{STORE_DOMAIN_SUFFIX}
							</span>
							<span id="store-slug-suffix" class="sr-only">Sufijo fijo: {STORE_DOMAIN_SUFFIX}</span>
						</div>
						<a href={SIGNUP_URL} class="mk-btn mk-btn-primary w-full px-5 sm:w-auto">
							Empezar Gratis
							<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6"></path>
							</svg>
						</a>
					</div>
					<p id="store-slug-help" class="mt-2 text-sm text-text-secondary">
						Vista previa en vivo. Elegirás el nombre definitivo al crear tu tienda.
					</p>
				</div>

				<ul
					class="mk-rise mt-7 flex flex-col gap-2.5 text-sm text-text-secondary sm:flex-row sm:flex-wrap sm:gap-x-5"
					style="animation-delay: 240ms"
				>
					<li class="flex items-center gap-2">
						<svg class="h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						Sin conocimientos técnicos
					</li>
					<li class="flex items-center gap-2">
						<svg class="h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						Sin tarjeta de crédito
					</li>
					<li class="flex items-center gap-2">
						<svg class="h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						Tu tienda lista para personalizar
					</li>
				</ul>
			</div>

			<!-- Columna derecha: escena de producto -->
			<div class="mk-rise relative lg:col-span-7" style="animation-delay: 160ms">
				<p class="sr-only">
					Vista previa ilustrativa del panel de tu tienda y de tu escaparate móvil. Los datos son de ejemplo.
				</p>
				<div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_9.5rem] lg:block" aria-hidden="true">
					<!-- Panel de administración -->
					<div
						class="relative overflow-hidden rounded-2xl bg-[#111827] text-[#E2E8F0] shadow-[0_30px_60px_-30px_rgba(15,23,42,0.65)] ring-1 ring-white/10 lg:ml-auto lg:w-[92%]"
					>
						<div class="flex items-center justify-between border-b border-white/10 px-3 py-2.5 sm:px-4">
							<div class="flex items-center gap-2">
								<span class="h-2 w-2 rounded-full bg-primary-mint"></span>
								<span class="font-mono text-[0.55rem] uppercase tracking-[0.14em] text-white/50 sm:text-[0.6rem]">
									Panel de tu tienda
								</span>
							</div>
							<div class="flex items-center gap-2">
								<span class="inline-flex items-center gap-1 rounded-full bg-primary-mint/10 px-2 py-0.5 text-[0.5rem] font-semibold text-primary-mint">
									<span class="h-1 w-1 rounded-full bg-primary-mint"></span>
									En línea
								</span>
								<span class="h-5 w-5 rounded-full bg-white/10"></span>
							</div>
						</div>

						<div class="flex">
							<!-- Barra lateral -->
							<div class="hidden w-28 shrink-0 border-r border-white/10 p-2.5 sm:block">
								<div class="space-y-0.5">
									<div class="flex items-center gap-1.5 rounded-md px-1.5 py-1 text-[0.5rem] text-white/55">
										<span class="h-1 w-1 rounded-full bg-current"></span>Inicio
									</div>
									<div class="flex items-center gap-1.5 rounded-md bg-primary-mint/10 px-1.5 py-1 text-[0.5rem] font-semibold text-primary-mint">
										<span class="h-1 w-1 rounded-full bg-current"></span>Pedidos
									</div>
									<div class="flex items-center gap-1.5 rounded-md px-1.5 py-1 text-[0.5rem] text-white/55">
										<span class="h-1 w-1 rounded-full bg-current"></span>Productos
									</div>
									<div class="flex items-center gap-1.5 rounded-md px-1.5 py-1 text-[0.5rem] text-white/55">
										<span class="h-1 w-1 rounded-full bg-current"></span>Clientes
									</div>
									<div class="flex items-center gap-1.5 rounded-md px-1.5 py-1 text-[0.5rem] text-white/55">
										<span class="h-1 w-1 rounded-full bg-current"></span>Envíos
									</div>
									<div class="flex items-center gap-1.5 rounded-md px-1.5 py-1 text-[0.5rem] text-white/55">
										<span class="h-1 w-1 rounded-full bg-current"></span>Pagos
									</div>
								</div>
								<div class="mt-4 rounded-lg bg-white/5 p-2">
									<p class="text-[0.5rem] uppercase tracking-[0.12em] text-white/55 sm:text-[0.45rem]">Plan</p>
									<p class="mt-0.5 text-[0.55rem] font-semibold text-white/85">Medio</p>
								</div>
							</div>

							<!-- Contenido -->
							<div class="min-w-0 flex-1 p-3">
								<div class="flex items-end justify-between gap-2">
									<div>
										<p class="text-[0.5rem] text-white/55">Hoy</p>
										<p class="font-display text-sm font-semibold text-white">Resumen de tu tienda</p>
									</div>
									<span class="rounded-md border border-white/10 px-1.5 py-0.5 font-mono text-[0.5rem] text-white/55 sm:text-[0.45rem]">
										Últimos 7 días
									</span>
								</div>

								<div class="mt-3 grid grid-cols-3 divide-x divide-white/10 border-y border-white/10 py-2.5">
									<div class="px-2">
										<p class="text-[0.5rem] text-white/55 sm:text-[0.45rem]">Ventas</p>
										<p class="mt-0.5 font-mono text-[0.68rem] font-semibold text-white">$1.284</p>
										<p class="text-[0.5rem] font-medium text-primary-mint sm:text-[0.42rem]">+18,2%</p>
									</div>
									<div class="px-2">
										<p class="text-[0.5rem] text-white/55 sm:text-[0.45rem]">Pedidos</p>
										<p class="mt-0.5 font-mono text-[0.68rem] font-semibold text-white">32</p>
										<p class="text-[0.5rem] font-medium text-primary-mint sm:text-[0.42rem]">+6 hoy</p>
									</div>
									<div class="px-2">
										<p class="text-[0.5rem] text-white/55 sm:text-[0.45rem]">Visitantes</p>
										<p class="mt-0.5 font-mono text-[0.68rem] font-semibold text-white">1.204</p>
										<p class="text-[0.5rem] font-medium text-white/55 sm:text-[0.42rem]">3,8% conv.</p>
									</div>
								</div>

								<div class="mt-3 border-t border-white/10 pt-2.5">
									<div class="flex items-center justify-between">
										<p class="text-[0.5rem] text-white/60 sm:text-[0.48rem]">Ventas de la semana</p>
										<span class="font-mono text-[0.5rem] text-primary-mint sm:text-[0.42rem]">+18,2%</span>
									</div>
									<svg class="mt-1 h-11 w-full" viewBox="0 0 220 44" preserveAspectRatio="none" aria-hidden="true">
										<defs>
											<linearGradient id="mk-sales-fill" x1="0" y1="0" x2="0" y2="1">
												<stop offset="0%" stop-color="#4CE1AC" stop-opacity="0.35"></stop>
												<stop offset="100%" stop-color="#4CE1AC" stop-opacity="0"></stop>
											</linearGradient>
										</defs>
										<path
											d="M0,36 C14,33 22,35 32,29 C44,22 52,27 64,23 C76,19 84,25 96,17 C108,10 118,15 130,11 C142,7 152,13 164,9 C176,5 190,8 220,3 L220,44 L0,44 Z"
											fill="url(#mk-sales-fill)"></path>
										<path
											class="mk-chart-line"
											d="M0,36 C14,33 22,35 32,29 C44,22 52,27 64,23 C76,19 84,25 96,17 C108,10 118,15 130,11 C142,7 152,13 164,9 C176,5 190,8 220,3"
											fill="none"
											stroke="#4CE1AC"
											stroke-width="1.6"
											stroke-linecap="round"
											pathLength="1"></path>
									</svg>
									<div class="flex justify-between font-mono text-[0.5rem] text-white/50 sm:text-[0.38rem]">
										<span>L</span><span>M</span><span>X</span><span>J</span><span>V</span><span>S</span><span>D</span>
									</div>
								</div>

								<div class="mt-3 border-t border-white/10 pt-2">
									<div class="flex items-center justify-between border-b border-white/10 pb-1.5">
										<p class="text-[0.5rem] font-medium text-white/70 sm:text-[0.48rem]">Pedidos recientes</p>
										<span class="text-[0.5rem] text-primary-mint sm:text-[0.42rem]">Ver todos</span>
									</div>
									<div class="flex items-center gap-2 border-b border-white/5 py-1.5">
										<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white/10 font-mono text-[0.5rem] text-white/70 sm:text-[0.42rem]">LM</span>
										<div class="min-w-0 flex-1">
											<p class="truncate text-[0.5rem] font-medium text-white/85 sm:text-[0.48rem]">Zapatilla urbana</p>
											<p class="text-[0.5rem] text-white/55 sm:text-[0.4rem]">Pedido #1042</p>
										</div>
										<span class="hidden rounded-full bg-whatsapp-green/15 px-1.5 py-0.5 text-[0.5rem] font-medium text-[#6EE7A8] sm:inline sm:text-[0.4rem]">WhatsApp</span>
										<span class="font-mono text-[0.5rem] text-white/80 sm:text-[0.48rem]">$48</span>
									</div>
									<div class="flex items-center gap-2 py-1.5">
										<span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white/10 font-mono text-[0.5rem] text-white/70 sm:text-[0.42rem]">SR</span>
										<div class="min-w-0 flex-1">
											<p class="truncate text-[0.5rem] font-medium text-white/85 sm:text-[0.48rem]">Camiseta dry-fit</p>
											<p class="text-[0.5rem] text-white/55 sm:text-[0.4rem]">Pedido #1041</p>
										</div>
										<span class="hidden rounded-full bg-secondary-blue/15 px-1.5 py-0.5 text-[0.5rem] font-medium text-secondary-blue sm:inline sm:text-[0.4rem]">Web</span>
										<span class="font-mono text-[0.5rem] text-white/80 sm:text-[0.48rem]">$24</span>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Tienda en móvil -->
					<div class="relative mx-auto w-[9.5rem] max-w-full lg:absolute lg:bottom-[-1.5rem] lg:left-[-1.5rem] lg:w-[9.5rem]">
						<div class="rounded-[1.75rem] bg-[#0F172A] p-2 shadow-[0_24px_50px_-20px_rgba(15,23,42,0.6)] ring-1 ring-black/10">
							<div class="overflow-hidden rounded-[1.35rem] bg-white text-[#0F172A]">
								<div class="flex items-center gap-1.5 border-b border-[#E2E8F0] bg-[#F8FAFC] px-2 py-2">
									<svg class="h-2.5 w-2.5 shrink-0 text-[#64748B]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
										<rect x="5" y="10" width="14" height="10" rx="2"></rect>
										<path d="M8 10V7a4 4 0 018 0v3"></path>
									</svg>
									<span class="min-w-0 truncate font-mono text-[0.5rem] text-[#52627A]">
										<span data-store-slug>{DEFAULT_STORE_SLUG}</span>{STORE_DOMAIN_SUFFIX}
									</span>
								</div>

								<div class="flex items-center justify-between px-2.5 py-2">
									<span class="min-w-0 truncate text-[0.62rem] font-bold" data-store-name>Tu marca</span>
									<svg class="h-3 w-3 shrink-0 text-[#0F172A]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
										<path stroke-linecap="round" stroke-linejoin="round" d="M6 8h12l-1 12H7L6 8z"></path>
										<path stroke-linecap="round" d="M9 8V6a3 3 0 016 0v2"></path>
									</svg>
								</div>

								<div class="mx-2 rounded-lg bg-gradient-to-br from-[#E6FAF5] to-[#DDEBFF] p-2">
									<p class="text-[0.5rem] font-semibold uppercase tracking-[0.1em] text-[#0A6B54] sm:text-[0.42rem]">Nueva colección</p>
									<p class="mt-0.5 text-[0.62rem] font-bold leading-tight">Tu tienda, lista para vender</p>
								</div>

								<div class="grid grid-cols-2 gap-1.5 p-2">
									<div>
										<div class="flex h-12 items-center justify-center rounded-md bg-gradient-to-br from-[#FDE68A] to-[#FCA5A5]">
											<svg class="h-5 w-5 text-[#7C2D12]/70" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
												<path d="M4 7l1.5 13h13L20 7H4zm5 3a3 3 0 006 0" fill="none" stroke="currentColor" stroke-width="1.6"></path>
											</svg>
										</div>
										<p class="mt-1 truncate text-[0.5rem] font-semibold sm:text-[0.46rem]">Zapatilla urbana</p>
										<p class="font-mono text-[0.5rem] text-[#52627A] sm:text-[0.42rem]">$48</p>
									</div>
									<div>
										<div class="flex h-12 items-center justify-center rounded-md bg-gradient-to-br from-[#BFDBFE] to-[#A7F3D0]">
											<svg class="h-5 w-5 text-[#1E3A8A]/60" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
												<path d="M8 4l4 4 4-4 3 4-3 12H8L5 8l3-4z" fill="none" stroke="currentColor" stroke-width="1.6"></path>
											</svg>
										</div>
										<p class="mt-1 truncate text-[0.5rem] font-semibold sm:text-[0.46rem]">Camiseta dry-fit</p>
										<p class="font-mono text-[0.5rem] text-[#52627A] sm:text-[0.42rem]">$24</p>
									</div>
								</div>

								<div class="px-2 pb-2">
									<div class="rounded-md bg-[#25D366] px-2 py-1.5 text-center text-[0.52rem] font-bold text-[#0B2E1A]">
										Pedir por WhatsApp
									</div>
									<p class="mt-1 text-center text-[0.5rem] text-[#64748B] sm:text-[0.4rem]">Pago seguro con Stripe</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Tarjetas flotantes -->
					<div class="grid grid-cols-2 gap-3 sm:col-span-2 lg:absolute lg:right-0 lg:top-[15%] lg:block lg:w-[11rem] lg:space-y-3">
						<div class="mk-float rounded-xl border border-black/5 bg-white p-3 shadow-[0_18px_40px_-18px_rgba(15,23,42,0.35)]">
							<div class="flex items-center gap-2">
								<span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#25D366]/15 text-[#0B7A60]">
									<svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
										<path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18a8 8 0 01-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8 8 0 1112 20zm4.4-6.1c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.1-.3.2-.5.1a6.5 6.5 0 01-3.2-2.8c-.1-.2 0-.4.1-.5l.7-.8c.1-.2.1-.3 0-.5l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.5.1-.7.4-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5-.1 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1-.1-.1-.2-.2-.4-.3z"></path>
									</svg>
								</span>
								<div class="min-w-0">
									<p class="text-[0.62rem] font-semibold text-[#0F172A]">Nuevo pedido</p>
									<p class="truncate text-[0.52rem] text-[#52627A]">Zapatilla urbana · $48</p>
								</div>
							</div>
							<div class="mt-2 flex items-center justify-between">
								<span class="rounded-full bg-[#E6FAF5] px-1.5 py-0.5 text-[0.5rem] font-semibold text-[#0B7A60] sm:text-[0.48rem]">Pagado</span>
								<span class="font-mono text-[0.5rem] text-[#64748B] sm:text-[0.42rem]">ahora</span>
							</div>
						</div>

						<div class="mk-float rounded-xl border border-black/5 bg-white p-3 shadow-[0_18px_40px_-18px_rgba(15,23,42,0.35)]" style="animation-delay: 1.2s">
							<p class="font-mono text-[0.5rem] uppercase tracking-[0.1em] text-[#52627A] sm:text-[0.46rem]">Ventas hoy</p>
							<div class="mt-0.5 flex items-baseline gap-1.5">
								<span class="font-mono text-base font-semibold text-[#0F172A]">$1.284</span>
								<span class="text-[0.52rem] font-semibold text-[#0B7A60]">+18,2%</span>
							</div>
							<svg class="mt-1 h-5 w-full" viewBox="0 0 96 18" preserveAspectRatio="none" aria-hidden="true">
								<path
									d="M0,14 C10,12 16,16 24,10 C32,4 40,9 48,6 C56,3 64,7 72,4 C80,2 88,5 96,3"
									fill="none"
									stroke="#0B7A60"
									stroke-width="1.4"
									stroke-linecap="round"
								></path>
							</svg>
						</div>
					</div>
				</div>

				<p class="mt-4 text-right font-mono text-xs uppercase tracking-[0.12em] text-text-secondary lg:pr-[8%]" aria-hidden="true">
					Datos de ejemplo
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.mk-wash {
		background: radial-gradient(
			58% 52% at 76% 30%,
			color-mix(in srgb, var(--primary-mint) 14%, transparent),
			transparent 72%
		);
	}

	@keyframes mk-rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.mk-rise {
		animation: mk-rise 0.7s var(--ease-out) both;
	}

	@keyframes mk-float {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(-6px);
		}
	}

	.mk-float {
		animation: mk-float 7s ease-in-out infinite alternate;
	}

	@keyframes mk-draw {
		from {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	.mk-chart-line {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: mk-draw 1.4s var(--ease-out) 0.5s both;
	}
</style>

<script>
	const input = document.getElementById('store-slug') as HTMLInputElement | null;
	const slugTargets = document.querySelectorAll('[data-store-slug]');
	const nameTargets = document.querySelectorAll('[data-store-name]');
	const fallbackSlug = input?.getAttribute('placeholder') || 'tu-marca';

	function toSlug(value: string) {
		return value
			.toLowerCase()
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '')
			.replace(/[^a-z0-9-]+/g, '-')
			.replace(/-{2,}/g, '-')
			.replace(/^-+|-+$/g, '')
			.slice(0, 30);
	}

	function toStoreName(value: string) {
		const clean = value.trim().replace(/\s+/g, ' ');
		return clean || 'Tu marca';
	}

	function renderPreview() {
		if (!input) return;
		const slug = toSlug(input.value) || fallbackSlug;
		const name = toStoreName(input.value);
		slugTargets.forEach((node) => {
			node.textContent = slug;
		});
		nameTargets.forEach((node) => {
			node.textContent = name;
		});
	}

	input?.addEventListener('input', renderPreview);
	renderPreview();
</script>
