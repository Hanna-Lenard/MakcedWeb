---
import { SIGNUP_URL } from '../../config/site';
---
<!-- Final CTA -->
<section aria-labelledby="cta-title" class="mk-section">
	<div class="mk-shell">
		<div class="mk-stage mx-auto max-w-3xl px-6 py-12 text-center sm:px-10 sm:py-14">
			<h2
				id="cta-title"
				class="mx-auto max-w-xl text-balance font-display text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-4xl"
			>
				¿Listo para lanzar tu tienda?
			</h2>
			<p class="mx-auto mt-4 max-w-lg text-lg leading-relaxed text-text-secondary">
				Únete a más de 500 negocios que ya venden con Makced
			</p>

			<div class="mx-auto mt-8 max-w-xl">
				<label for="cta-slug" class="sr-only">Nombre de tu tienda</label>
				<div
					class="flex flex-col gap-2 rounded-2xl border border-border-color bg-surface-raised p-2 shadow-card transition-[border-color,box-shadow] focus-within:border-mint-ink focus-within:ring-4 focus-within:ring-primary-mint/20 sm:flex-row sm:items-center"
				>
					<input
						id="cta-slug"
						type="text"
						inputmode="url"
						autocomplete="off"
						autocapitalize="off"
						spellcheck="false"
						maxlength="30"
						placeholder="tu-marca"
						class="min-w-0 flex-1 bg-transparent px-3 py-2.5 text-text-primary placeholder:text-text-secondary focus:outline-none"
					/>
					<span class="hidden shrink-0 font-mono text-sm text-text-secondary sm:block" aria-hidden="true">
						.makced.com
					</span>
					<a href={SIGNUP_URL} class="mk-btn mk-btn-primary w-full sm:w-auto">Empezar Gratis</a>
				</div>
				<p class="mt-3 text-sm text-text-secondary">Sin tarjeta de crédito</p>
			</div>
		</div>
	</div>
</section>
