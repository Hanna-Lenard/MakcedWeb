---
---
<!-- Payments Section -->
<section aria-labelledby="payments-title" class="mk-section">
	<div class="mk-shell">
		<div class="mx-auto max-w-3xl text-center">
			<h2
				id="payments-title"
				class="text-balance font-display text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-4xl lg:text-5xl"
			>
				Aislamiento de Pagos (Stripe Connect)
			</h2>
			<p class="mt-4 text-lg leading-relaxed text-text-secondary">
				Los fondos van 100% directos a tu cuenta bancaria, sin intermediarios ni retenciones abusivas
			</p>
		</div>

		<div class="mk-stage mx-auto mt-10 max-w-4xl p-6 sm:mt-12 sm:p-10">
			<div class="flex flex-col items-center justify-center gap-6 sm:flex-row sm:gap-8">
				<div class="flex flex-col items-center text-center">
					<span class="flex h-14 w-14 items-center justify-center rounded-2xl border border-border-color bg-surface-raised text-mint-ink">
						<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 8h12l-1 12H7L6 8z"></path>
							<path stroke-linecap="round" d="M9 8V6a3 3 0 0 1 6 0v2"></path>
						</svg>
					</span>
					<p class="mt-3 text-sm font-medium text-text-primary">Cliente</p>
				</div>

				<svg class="h-5 w-5 rotate-90 text-mint-ink sm:rotate-0" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 12h15M14 6l6 6-6 6"></path>
				</svg>

				<div class="flex flex-col items-center text-center">
					<span
						class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary-mint text-lg font-bold text-[#0F172A] shadow-float"
					>
						M
					</span>
					<p class="mt-3 text-sm font-medium text-text-primary">Makced</p>
				</div>

				<svg class="h-5 w-5 rotate-90 text-mint-ink sm:rotate-0" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 12h15M14 6l6 6-6 6"></path>
				</svg>

				<div class="flex flex-col items-center text-center">
					<span class="flex h-14 w-14 items-center justify-center rounded-2xl border border-border-color bg-surface-raised text-mint-ink">
						<svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l9 6H3l9-6z"></path>
							<path stroke-linecap="round" d="M5 10v8M9.5 10v8M14.5 10v8M19 10v8"></path>
							<path stroke-linecap="round" d="M3 21h18"></path>
						</svg>
					</span>
					<p class="mt-3 text-sm font-medium text-text-primary">Tu Banco</p>
					<p class="text-xs font-semibold text-mint-ink">100% directo</p>
				</div>
			</div>
		</div>
	</div>
</section>
