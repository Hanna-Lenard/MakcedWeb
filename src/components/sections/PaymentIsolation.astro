---
---
<!-- Payments Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8 bg-bg-card/50">
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-16">
			<h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">Aislamiento de Pagos (Stripe Connect)</h2>
			<p class="text-xl text-text-secondary max-w-3xl mx-auto">
				Los fondos van 100% directos a tu cuenta bancaria, sin intermediarios ni retenciones abusivas
			</p>
		</div>
		<div class="max-w-4xl mx-auto p-8 bg-linear-to-br from-primary-mint-light to-secondary-blue/10 dark:from-primary-mint-dark/30 dark:to-secondary-purple/20 rounded-3xl">
			<div class="flex flex-col md:flex-row items-center justify-center gap-8">
				<div class="text-center">
					<div class="w-16 h-16 bg-white dark:bg-bg-card rounded-full flex items-center justify-center mx-auto mb-3 shadow-card">
						<span class="text-2xl">🛍️</span>
					</div>
					<p class="text-text-primary font-medium">Cliente</p>
				</div>
				<svg class="w-8 h-8 text-primary-mint rotate-90 md:rotate-0" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
				</svg>
				<div class="text-center">
					<div class="w-16 h-16 bg-linear-to-r from-primary-mint to-primary-turquoise rounded-full flex items-center justify-center mx-auto mb-3 shadow-glow-mint">
						<span class="text-white font-bold">M</span>
					</div>
					<p class="text-text-primary font-medium">Makced</p>
				</div>
				<svg class="w-8 h-8 text-primary-mint rotate-90 md:rotate-0" fill="currentColor" viewBox="0 0 20 20">
					<path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
				</svg>
				<div class="text-center">
					<div class="w-16 h-16 bg-white dark:bg-bg-card rounded-full flex items-center justify-center mx-auto mb-3 shadow-card">
						<span class="text-2xl">🏦</span>
					</div>
					<p class="text-text-primary font-medium">Tu Banco</p>
					<p class="text-xs text-primary-mint font-bold">100% directo</p>
				</div>
			</div>
		</div>
	</div>
</section>
