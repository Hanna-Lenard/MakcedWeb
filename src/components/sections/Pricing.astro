---
---
<!-- Pricing Section -->
<section id="precios" aria-labelledby="pricing-title" class="mk-section">
	<div class="mk-shell">
		<div class="mx-auto max-w-3xl text-center">
			<h2
				id="pricing-title"
				class="text-balance font-display text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-4xl lg:text-5xl"
			>
				Planes Flexibles y Transparentes
			</h2>
			<p class="mt-4 text-lg leading-relaxed text-text-secondary">
				Sin sorpresas, sin comisiones ocultas
			</p>
		</div>

		<div class="mx-auto mt-10 grid max-w-5xl gap-6 sm:mt-12 md:grid-cols-3">
			<!-- Basic Plan -->
			<article class="mk-card flex flex-col p-6 sm:p-8">
				<h3 class="font-display text-xl font-bold tracking-[-0.01em] text-text-primary">Plan Básico</h3>
				<p class="mt-4 flex items-baseline gap-1">
					<span class="font-display text-4xl font-bold tracking-[-0.02em] text-text-primary">€9</span>
					<span class="text-sm text-text-secondary">/mes</span>
				</p>
				<ul class="mt-6 space-y-3 border-t border-border-color pt-6">
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Tienda online completa</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Dominio subdominio Makced</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Productos ilimitados</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Soporte por email</span>
					</li>
				</ul>
				<div class="mt-auto pt-8">
					<a href="https://tu-tienda.makced.com" class="mk-btn mk-btn-ghost w-full" aria-label="Empezar con el Plan Básico">
						Empezar
					</a>
				</div>
			</article>

			<!-- Recommended Plan -->
			<article class="mk-stage relative flex flex-col p-6 ring-2 ring-primary-mint sm:p-8">
				<p
					class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-primary-mint px-3 py-1 text-xs font-semibold text-[#0F172A]"
				>
					Recomendado
				</p>
				<h3 class="font-display text-xl font-bold tracking-[-0.01em] text-text-primary">Plan Medio</h3>
				<p class="mt-4 flex items-baseline gap-1">
					<span class="font-display text-4xl font-bold tracking-[-0.02em] text-text-primary">€29</span>
					<span class="text-sm text-text-secondary">/mes</span>
				</p>
				<ul class="mt-6 space-y-3 border-t border-border-color pt-6">
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Todo lo del Plan Básico</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Dominio propio</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Descripciones con IA</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Ventas por WhatsApp</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Soporte prioritario por WhatsApp</span>
					</li>
				</ul>
				<div class="mt-auto pt-8">
					<a href="https://tu-tienda.makced.com" class="mk-btn mk-btn-primary w-full" aria-label="Empezar con el Plan Medio, recomendado">
						Empezar
					</a>
				</div>
			</article>

			<!-- Pro Plan -->
			<article class="mk-card flex flex-col p-6 sm:p-8">
				<h3 class="font-display text-xl font-bold tracking-[-0.01em] text-text-primary">Plan Pro</h3>
				<p class="mt-4 flex items-baseline gap-1">
					<span class="font-display text-4xl font-bold tracking-[-0.02em] text-text-primary">€79</span>
					<span class="text-sm text-text-secondary">/mes</span>
				</p>
				<ul class="mt-6 space-y-3 border-t border-border-color pt-6">
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Todo lo del Plan Medio</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Estadísticas avanzadas</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Integraciones avanzadas</span>
					</li>
					<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
						<svg class="mt-0.5 h-4 w-4 shrink-0 text-mint-ink" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4.2 4.2L19 7"></path>
						</svg>
						<span>Desarrollo VIP</span>
					</li>
				</ul>
				<div class="mt-auto pt-8">
					<a href="https://tu-tienda.makced.com" class="mk-btn mk-btn-ghost w-full" aria-label="Empezar con el Plan Pro">
						Empezar
					</a>
				</div>
			</article>
		</div>
	</div>
</section>
