---
---
<!-- Pricing Section -->
<section id="precios" class="py-20 px-4 sm:px-6 lg:px-8 bg-bg-card/50">
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-16">
			<h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">Planes Flexibles y Transparentes</h2>
			<p class="text-xl text-text-secondary">Sin sorpresas, sin comisiones ocultas</p>
		</div>
		<div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
			<!-- Basic Plan -->
			<div class="p-8 bg-bg-card rounded-2xl border border-border-color shadow-card">
				<h3 class="text-2xl font-bold text-text-primary mb-2">Plan Básico</h3>
				<div class="mb-6">
					<span class="text-4xl font-bold text-text-primary">€9</span>
					<span class="text-text-secondary">/mes</span>
				</div>
				<ul class="space-y-3 mb-8">
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Tienda online completa</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Dominio subdominio Makced</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Productos ilimitados</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Soporte por email</span>
					</li>
				</ul>
				<a href="https://tu-tienda.makced.com" class="block w-full text-center py-3 px-6 border border-primary-mint text-primary-mint rounded-full hover:bg-primary-mint-light dark:hover:bg-primary-mint-dark transition-all">
					Empezar
				</a>
			</div>
			
			<!-- Recommended Plan -->
			<div class="p-8 bg-linear-to-br from-primary-mint-light to-secondary-blue/10 dark:from-primary-mint-dark/30 dark:to-secondary-purple/20 rounded-2xl border-2 border-primary-mint shadow-glow-mint relative">
				<div class="absolute -top-4 left-1/2 transform -translate-x-1/2 px-4 py-1 bg-linear-to-r from-primary-mint to-primary-turquoise text-white rounded-full text-sm font-medium">
					Recomendado
				</div>
				<h3 class="text-2xl font-bold text-text-primary mb-2">Plan Medio</h3>
				<div class="mb-6">
					<span class="text-4xl font-bold text-text-primary">€29</span>
					<span class="text-text-secondary">/mes</span>
				</div>
				<ul class="space-y-3 mb-8">
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Todo lo del Plan Básico</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Dominio propio</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Descripciones con IA</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Ventas por WhatsApp</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Soporte prioritario por WhatsApp</span>
					</li>
				</ul>
				<a href="https://tu-tienda.makced.com" class="block w-full text-center py-3 px-6 bg-linear-to-r from-primary-mint to-primary-turquoise text-white rounded-full hover:shadow-glow-mint transition-all">
					Empezar
				</a>
			</div>
			
			<!-- Pro Plan -->
			<div class="p-8 bg-bg-card rounded-2xl border border-border-color shadow-card">
				<h3 class="text-2xl font-bold text-text-primary mb-2">Plan Pro</h3>
				<div class="mb-6">
					<span class="text-4xl font-bold text-text-primary">€79</span>
					<span class="text-text-secondary">/mes</span>
				</div>
				<ul class="space-y-3 mb-8">
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Todo lo del Plan Medio</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Estadísticas avanzadas</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Integraciones avanzadas</span>
					</li>
					<li class="flex items-start gap-2 text-text-secondary">
						<span class="text-primary-mint">✓</span>
						<span>Desarrollo VIP</span>
					</li>
				</ul>
				<a href="https://tu-tienda.makced.com" class="block w-full text-center py-3 px-6 border border-primary-mint text-primary-mint rounded-full hover:bg-primary-mint-light dark:hover:bg-primary-mint-dark transition-all">
					Empezar
				</a>
			</div>
		</div>
	</div>
</section>
