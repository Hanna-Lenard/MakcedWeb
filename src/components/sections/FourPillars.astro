---
---
<!-- Four Pillars -->
<section aria-labelledby="pillars-title" class="mk-section">
	<div class="mk-shell">
		<h2
			id="pillars-title"
			class="max-w-3xl text-balance font-display text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-4xl lg:text-5xl"
		>
			Los Cuatro Pilares
		</h2>

		<div class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 sm:gap-6 lg:grid-cols-4">
			<article class="mk-card p-6">
				<span class="mk-icon-tile">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13 2 4 14h6l-1 8 9-12h-6l1-8z"></path>
					</svg>
				</span>
				<h3 class="mt-5 font-display text-lg font-bold tracking-[-0.01em] text-text-primary">
					Fricción técnica cero
				</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-secondary">Sin código, sin complicaciones</p>
			</article>

			<article class="mk-card p-6">
				<span class="mk-icon-tile">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" d="M17 7a6 6 0 1 0 0 10"></path>
						<path stroke-linecap="round" d="M6 10h8M6 14h8"></path>
					</svg>
				</span>
				<h3 class="mt-5 font-display text-lg font-bold tracking-[-0.01em] text-text-primary">
					Costos predecibles
				</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-secondary">Sin comisiones por venta</p>
			</article>

			<article class="mk-card p-6">
				<span class="mk-icon-tile">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V4h8a2 2 0 0 1 1.4.6l8.2 8.2a2 2 0 0 1 0 2.6Z"></path>
						<circle cx="7.5" cy="7.5" r="1.2"></circle>
					</svg>
				</span>
				<h3 class="mt-5 font-display text-lg font-bold tracking-[-0.01em] text-text-primary">
					Identidad/marca propia
				</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-secondary">Tu dominio, tu marca</p>
			</article>

			<article class="mk-card p-6">
				<span class="mk-icon-tile">
					<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6l8-3z"></path>
						<path stroke-linecap="round" stroke-linejoin="round" d="M8.5 12l2.5 2.5L16 9"></path>
					</svg>
				</span>
				<h3 class="mt-5 font-display text-lg font-bold tracking-[-0.01em] text-text-primary">
					Mantenimiento invisible
				</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-secondary">Sin preocuparte por el backend</p>
			</article>
		</div>
	</div>
</section>
