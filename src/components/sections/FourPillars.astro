---
---
<!-- Four Pillars -->
<section class="py-20 px-4 sm:px-6 lg:px-8">
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-16">
			<h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">Los Cuatro Pilares</h2>
		</div>
		<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
			<div class="p-6 bg-bg-card rounded-2xl border border-border-color shadow-card text-center">
				<div class="w-12 h-12 bg-linear-to-r from-primary-mint to-primary-turquoise rounded-full flex items-center justify-center mx-auto mb-4">
					<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
					</svg>
				</div>
				<h3 class="text-lg font-bold text-text-primary mb-2">Fricción técnica cero</h3>
				<p class="text-sm text-text-secondary">Sin código, sin complicaciones</p>
			</div>
			<div class="p-6 bg-bg-card rounded-2xl border border-border-color shadow-card text-center">
				<div class="w-12 h-12 bg-linear-to-r from-secondary-blue to-secondary-purple rounded-full flex items-center justify-center mx-auto mb-4">
					<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
						<path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.42.621.726 1.29 1.825 1.91-.558.168-1.045.36-1.811 1.35V12.85z"/>
						<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"/>
					</svg>
				</div>
				<h3 class="text-lg font-bold text-text-primary mb-2">Costos predecibles</h3>
				<p class="text-sm text-text-secondary">Sin comisiones por venta</p>
			</div>
			<div class="p-6 bg-bg-card rounded-2xl border border-border-color shadow-card text-center">
				<div class="w-12 h-12 bg-gradient-to-r from-accent-star to-orange-400 rounded-full flex items-center justify-center mx-auto mb-4">
					<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L11 6.477V16h2a1 1 0 110 2H7a1 1 0 110-2h2V6.477L6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.617a1 1 0 01.894-1.788l1.599.799L9 3.323V2a1 1 0 011-1zm-5 8.274l-.818 2.552c.25.112.526.177 8 5.174.55 0 1.635-.125 2.247-1.168L5 8.104zM10 13c-1.844 0-3.088-.395 9-1.206l1.43-4.465L10 5.91l-5.43 2.419 1.43 4.465c.612 1.213 1.846 1.206 9 1.206z" clip-rule="evenodd"/>
					</svg>
				</div>
				<h3 class="text-lg font-bold text-text-primary mb-2">Identidad/marca propia</h3>
				<p class="text-sm text-text-secondary">Tu dominio, tu marca</p>
			</div>
			<div class="p-6 bg-bg-card rounded-2xl border border-border-color shadow-card text-center">
				<div class="w-12 h-12 bg-gradient-to-r from-primary-mint to-secondary-purple rounded-full flex items-center justify-center mx-auto mb-4">
					<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M2 5a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V5zm3.293 1.293a1 1 0 011.414 0l3 3a1 1 0 010 1.414l-3 3a1 1 0 01-1.414-1.414L7.586 10 5.293 7.707a1 1 0 010-1.414zM11 12a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
					</svg>
				</div>
				<h3 class="text-lg font-bold text-text-primary mb-2">Mantenimiento invisible</h3>
				<p class="text-sm text-text-secondary">Sin preocuparte por el backend</p>
			</div>
		</div>
	</div>
</section>
