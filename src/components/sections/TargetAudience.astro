<!-- Target Audience -->
<section class="py-20 px-4 sm:px-6 lg:px-8 bg-bg-card/50">
	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-16">
			<h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">Diseñado para ti</h2>
		</div>
		<div class="grid md:grid-cols-2 gap-8">
			<div class="p-8 bg-bg-card rounded-2xl border border-border-color shadow-card hover:shadow-glow-mint transition-all">
				<div class="text-4xl mb-4">🎨</div>
				<h3 class="text-2xl font-bold text-text-primary mb-4">Creadores y Emprendedores</h3>
				<p class="text-text-secondary">
					Monetiza tu talento. Lanza tu tienda para productos digitales, merchandising o arte sin complicarte.
				</p>
			</div>
			<div class="p-8 bg-bg-card rounded-2xl border border-border-color shadow-card hover:shadow-glow-mint transition-all">
				<div class="text-4xl mb-4">🏢</div>
				<h3 class="text-2xl font-bold text-text-primary mb-4">Pequeñas Empresas (PyMEs)</h3>
				<p class="text-text-secondary">
					Digitaliza tu negocio. Vende online con tu propia marca, sin pagar comisiones abusivas.
				</p>
			</div>
		</div>
	</div>
</section>
