---
---
<!-- Target Audience -->
<section aria-labelledby="audience-title" class="mk-section">
	<div class="mk-shell">
		<h2
			id="audience-title"
			class="max-w-3xl text-balance font-display text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-4xl lg:text-5xl"
		>
			Diseñado para ti
		</h2>

		<div
			class="mt-10 grid gap-10 border-t border-border-color pt-10 sm:mt-12 sm:grid-cols-2 sm:gap-0 sm:divide-x sm:divide-border-color sm:pt-12"
		>
			<div class="sm:pr-10">
				<svg class="h-9 w-9 text-mint-ink" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						d="M12 3a9 9 0 0 0 0 18c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.2 0-.9.7-1.5 1.5-1.5H16a5 5 0 0 0 5-5c0-4.4-4-8-9-8Z"
					></path>
					<circle cx="8" cy="9" r="1.1"></circle>
					<circle cx="12" cy="7" r="1.1"></circle>
					<circle cx="16" cy="9" r="1.1"></circle>
				</svg>
				<h3 class="mt-5 font-display text-xl font-bold tracking-[-0.01em] text-text-primary sm:text-2xl">
					Creadores y Emprendedores
				</h3>
				<p class="mt-3 max-w-md text-base leading-relaxed text-text-secondary">
					Monetiza tu talento. Lanza tu tienda para productos digitales, merchandising o arte sin complicarte.
				</p>
			</div>

			<div class="sm:pl-10">
				<svg class="h-9 w-9 text-mint-ink" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18"></path>
					<path stroke-linecap="round" stroke-linejoin="round" d="M5 21V5a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v16"></path>
					<path stroke-linecap="round" stroke-linejoin="round" d="M15 10h4a1 1 0 0 1 1 1v10"></path>
					<path stroke-linecap="round" d="M8 8h4M8 12h4M8 16h4"></path>
				</svg>
				<h3 class="mt-5 font-display text-xl font-bold tracking-[-0.01em] text-text-primary sm:text-2xl">
					Pequeñas Empresas (PyMEs)
				</h3>
				<p class="mt-3 max-w-md text-base leading-relaxed text-text-secondary">
					Digitaliza tu negocio. Vende online con tu propia marca, sin pagar comisiones abusivas.
				</p>
			</div>
		</div>
	</div>
</section>
