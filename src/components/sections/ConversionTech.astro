---
---
<!-- Technology Section -->
<section id="caracteristicas" aria-labelledby="tech-title" class="mk-section">
	<div class="mk-shell">
		<div class="mk-shelf" aria-hidden="true"></div>

		<h2
			id="tech-title"
			class="mt-10 max-w-3xl text-balance font-display text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-text-primary sm:mt-12 sm:text-4xl lg:text-5xl"
		>
			Tecnología que multiplica conversiones
		</h2>

		<div class="mt-8 grid gap-4 sm:mt-10 sm:gap-6 md:grid-cols-2 lg:gap-8">
			<article class="mk-card p-6 sm:p-7">
				<div class="flex items-center gap-4">
					<span class="mk-icon-tile">
						<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M12 4l1.6 4.4L18 10l-4.4 1.6L12 16l-1.6-4.4L6 10l4.4-1.6z"
							></path>
							<path stroke-linecap="round" stroke-linejoin="round" d="M18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"></path>
						</svg>
					</span>
					<h3 class="font-display text-xl font-bold tracking-[-0.01em] text-text-primary">
						Descripciones con IA
					</h3>
				</div>
				<p class="mt-5 text-base leading-relaxed text-text-secondary">
					Sube una foto y genera textos persuasivos para tus productos en segundos. Optimizado para vender.
				</p>
			</article>

			<article class="mk-card p-6 sm:p-7">
				<div class="flex items-center gap-4">
					<span class="mk-icon-tile border-whatsapp-green/30 bg-whatsapp-green/10">
						<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M21 11.5a8.4 8.4 0 0 1-8.5 8.5 8.6 8.6 0 0 1-3.9-.9L3 21l1.9-5.6a8.4 8.4 0 0 1-.9-3.9A8.5 8.5 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5Z"
							></path>
							<path stroke-linecap="round" d="M8.5 10.5h7M8.5 13.5h4"></path>
						</svg>
					</span>
					<h3 class="font-display text-xl font-bold tracking-[-0.01em] text-text-primary">
						Cierre de ventas directo por WhatsApp
					</h3>
				</div>
				<p class="mt-5 text-base leading-relaxed text-text-secondary">
					Facilita la conversación con tus clientes. Vende directamente por WhatsApp sin fricción.
				</p>
			</article>
		</div>
	</div>
</section>
