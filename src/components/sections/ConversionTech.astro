	<div class="max-w-7xl mx-auto">
		<div class="text-center mb-16">
			<h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">Tecnología que multiplica conversiones</h2>
		</div>
		<div class="grid md:grid-cols-2 gap-8">
			<div class="p-8 bg-bg-card rounded-2xl border border-border-color shadow-card">
				<div class="flex items-center gap-4 mb-4">
					<div class="w-12 h-12 bg-linear-to-r from-secondary-purple to-primary-mint rounded-full flex items-center justify-center">
						<svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
							<path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>
