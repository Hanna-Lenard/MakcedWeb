<!-- Problem Section -->
<section class="py-20 px-4 sm:px-6 lg:px-8 bg-bg-card/50">
	<div class="max-w-7xl mx-auto">
		<div class="max-w-7xl mx-auto">
			<h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4">El problema actual</h2>
			<p class="text-xl text-text-secondary">Dos opciones que no funcionan para pequeños negocios</p>
		</div>
		<div class="grid md:grid-cols-2 gap-8">
			<div class="p-8 bg-bg-card rounded-2xl border border-border-color shadow-card">
				<div class="text-red-500 text-4xl mb-4">✗</div>
				<h3 class="text-2xl font-bold text-text-primary mb-4">Agencias de desarrollo a medida</h3>
				<ul class="space-y-3 text-text-secondary">
					<li class="flex items-start gap-2">
						<span class="text-red-500">•</span>
						<span>Lentas - Meses de desarrollo</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-red-500">•</span>
						<span>Costosas - Miles de euros</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-red-500">•</span>
						<span>Complejas - Requieren mantenimiento</span>
					</li>
				</ul>
			</div>
			<div class="p-8 bg-bg-card rounded-2xl border border-border-color shadow-card">
				<div class="text-red-500 text-4xl mb-4">✗</div>
				<h3 class="text-2xl font-bold text-text-primary mb-4">Marketplaces tradicionales</h3>
				<ul class="space-y-3 text-text-secondary">
					<li class="flex items-start gap-2">
						<span class="text-red-500">•</span>
						<span>Comisiones abusivas del 15%</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-red-500">•</span>
						<span>Retención de fondos</span>
					</li>
					<li class="flex items-start gap-2">
						<span class="text-red-500">•</span>
						<span>Sin identidad de marca propia</span>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>
