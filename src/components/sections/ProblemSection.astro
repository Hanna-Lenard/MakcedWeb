---
---
<!-- Problem Section -->
<section aria-labelledby="problem-title" class="mk-section">
	<div class="mk-shell">
		<h2
			id="problem-title"
			class="max-w-3xl text-balance font-display text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-4xl lg:text-5xl"
		>
			El talento sobra, pero la barra tecnológica frena el crecimiento.
		</h2>

		<div class="mk-shelf mt-8 sm:mt-10" aria-hidden="true"></div>

		<div class="mt-8 grid gap-4 sm:mt-10 sm:gap-6 md:grid-cols-2 lg:gap-8">
			<!-- Escaparate cerrado: agencia -->
			<article class="mk-card flex flex-col overflow-hidden">
				<div class="relative h-32 overflow-hidden sm:h-36">
					<div class="pointer-events-none absolute inset-0 bg-linear-to-b from-surface-sunken to-transparent" aria-hidden="true"></div>
					<svg
						class="absolute inset-0 h-full w-full"
						viewBox="0 0 320 120"
						preserveAspectRatio="xMidYMid meet"
						fill="none"
						aria-hidden="true"
					>
						<g
							class="text-text-secondary"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M12 104h296"></path>
							<path d="M112 104V46h104v58"></path>
							<path d="M104 46l14-16h92l14 16z"></path>
							<path d="M126 30v16M146 30v16M166 30v16M186 30v16M206 30v16" opacity=".55"></path>
							<path d="M136 104V68h30v36"></path>
							<path d="M176 86V70h26v16"></path>
							<path d="M44 104V22M78 104V22" opacity=".7"></path>
							<path d="M44 40h56M44 66h56M44 92h56" opacity=".7"></path>
							<circle cx="268" cy="32" r="12"></circle>
							<path d="M268 32v-8M268 32h6"></path>
						</g>
						<g
							class="text-amber-ink"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<rect x="128" y="84" width="46" height="10" rx="2"></rect>
							<path d="M136 94l9-10M148 94l9-10M160 94l9-10" opacity=".85"></path>
						</g>
					</svg>
				</div>

				<div class="flex flex-1 flex-col p-6 sm:p-7">
					<h3 class="font-display text-xl font-bold tracking-[-0.01em] text-text-primary sm:text-2xl">
						Agencias y Desarrollo a Medida
					</h3>
					<p class="mt-3 text-base leading-relaxed text-text-secondary">
						Lento, costos iniciales altísimos y mantenimiento técnico impredecible que te hace depender de terceros.
					</p>

					<ul class="mt-6 space-y-3 border-t border-border-color pt-6">
						<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
							<svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-ink" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
								<circle cx="12" cy="12" r="9"></circle>
								<path stroke-linecap="round" d="M12 7v5l3 2"></path>
							</svg>
							<span>Meses de desarrollo antes de la primera venta</span>
						</li>
						<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
							<svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-ink" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V4h8a2 2 0 0 1 1.4.6l8.2 8.2a2 2 0 0 1 0 2.6Z"></path>
								<circle cx="7.5" cy="7.5" r="1.2"></circle>
							</svg>
							<span>Miles de euros de inversión inicial</span>
						</li>
						<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
							<svg class="mt-0.5 h-4 w-4 shrink-0 text-amber-ink" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
							</svg>
							<span>Mantenimiento técnico continuo a tu cargo</span>
						</li>
					</ul>
				</div>
			</article>

			<!-- Escaparate cerrado: marketplace -->
			<article class="mk-card flex flex-col overflow-hidden">
				<div class="relative h-32 overflow-hidden sm:h-36">
					<div class="pointer-events-none absolute inset-0 bg-linear-to-b from-surface-sunken to-transparent" aria-hidden="true"></div>
					<svg
						class="absolute inset-0 h-full w-full"
						viewBox="0 0 320 120"
						preserveAspectRatio="xMidYMid meet"
						fill="none"
						aria-hidden="true"
					>
						<g
							class="text-text-secondary"
							stroke="currentColor"
							stroke-width="1.4"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M12 104h296"></path>
							<path d="M64 62h192M64 96h192"></path>
							<path d="M86 62V44h12v18M89 44v-7h6v7"></path>
							<path d="M118 62V42h24v20M118 50h24"></path>
							<path d="M162 62V46h18v16M164 46v-4h14v4"></path>
							<path d="M92 96V82h26v14M92 88h26"></path>
							<path d="M140 96V76h20v20"></path>
							<path d="M188 96V84h24v12"></path>
							<path d="M112 4h96v20h-96z" stroke-dasharray="4 4"></path>
						</g>
						<g
							class="text-violet-ink"
							stroke="currentColor"
							stroke-width="1.6"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path
								d="M56 30v74M72 30v74M88 30v74M104 30v74M120 30v74M136 30v74M152 30v74M168 30v74M184 30v74M200 30v74M216 30v74M232 30v74M248 30v74M264 30v74M56 30h208"
								opacity=".4"
							></path>
							<path d="M124 22l44-16"></path>
							<circle cx="270" cy="78" r="2.5"></circle>
							<circle cx="280" cy="90" r="2.5"></circle>
							<path d="M281 76l-13 16"></path>
						</g>
					</svg>
				</div>

				<div class="flex flex-1 flex-col p-6 sm:p-7">
					<h3 class="font-display text-xl font-bold tracking-[-0.01em] text-text-primary sm:text-2xl">
						Marketplaces Tradicionales
					</h3>
					<p class="mt-3 text-base leading-relaxed text-text-secondary">
						Eres solo un vendedor más. Comisiones abusivas por venta, pérdida total de identidad de marca y nulo control sobre tus propios clientes (Amazon, MercadoLibre).
					</p>

					<ul class="mt-6 space-y-3 border-t border-border-color pt-6">
						<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
							<svg class="mt-0.5 h-4 w-4 shrink-0 text-violet-ink" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" d="M19 5 5 19"></path>
								<circle cx="6.5" cy="6.5" r="2.5"></circle>
								<circle cx="17.5" cy="17.5" r="2.5"></circle>
							</svg>
							<span>Comisiones abusivas del 15% por venta</span>
						</li>
						<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
							<svg class="mt-0.5 h-4 w-4 shrink-0 text-violet-ink" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
								<rect x="4" y="11" width="16" height="9" rx="2"></rect>
								<path stroke-linecap="round" d="M8 11V7a4 4 0 0 1 8 0v4"></path>
							</svg>
							<span>Retención de fondos antes de cobrar</span>
						</li>
						<li class="flex items-start gap-3 text-sm leading-relaxed text-text-secondary">
							<svg class="mt-0.5 h-4 w-4 shrink-0 text-violet-ink" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V4h8a2 2 0 0 1 1.4.6l8.2 8.2a2 2 0 0 1 0 2.6Z"></path>
								<path stroke-linecap="round" d="M4 4l16 16"></path>
							</svg>
							<span>Sin identidad de marca propia</span>
						</li>
					</ul>
				</div>
			</article>
		</div>

		<div class="mt-12 sm:mt-14">
			<div class="h-px w-10 bg-mint-ink" aria-hidden="true"></div>
			<p class="mt-5 max-w-3xl text-balance font-display text-xl font-semibold leading-snug tracking-[-0.01em] text-text-primary sm:text-2xl">
				Construir tu negocio no debería obligarte a elegir entre la ruina financiera o ceder tus márgenes.
			</p>
		</div>
	</div>
</section>
