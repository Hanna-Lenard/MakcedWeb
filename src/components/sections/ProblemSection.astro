---
import { Picture } from 'astro:assets';
import exhaustedDeveloper from '../../assets/problem/desarrollador-agotado.png';
import marketplaceConfusion from '../../assets/problem/confusion-marketplace.png';
---

<!-- Problem Section -->
<section aria-labelledby="problem-title" class="mk-section">
	<div class="mk-shell">
		<h2
			id="problem-title"
			class="max-w-3xl text-balance font-display text-3xl font-bold leading-[1.08] tracking-[-0.03em] text-text-primary sm:text-4xl lg:text-5xl"
		>
			El talento sobra, pero la barrera tecnológica frena el crecimiento.
		</h2>

		<div class="mk-shelf mt-8 sm:mt-10" aria-hidden="true"></div>

		<div class="mt-10 space-y-8 sm:mt-12 sm:space-y-10 lg:mt-14 lg:space-y-14">
			<!-- Escaparate cerrado: agencia -->
			<article
				class="problem-row problem-row--mint problem-row--visual-start grid items-center gap-6 sm:gap-8 lg:grid-cols-12 lg:gap-10"
			>
				<div class="problem-card mk-card order-2 min-w-0 overflow-hidden p-6 sm:p-8 lg:order-2 lg:col-span-7">
					<span class="problem-label">
						<span class="problem-label-dot" aria-hidden="true"></span>
						Agencias
					</span>
					<h3 class="mt-4 font-display text-2xl font-bold tracking-[-0.01em] text-text-primary sm:text-[1.75rem]">
						Agencias y Desarrollo a Medida
					</h3>
					<p class="mt-3 max-w-[62ch] text-base leading-relaxed text-text-secondary">
						Lento, costos iniciales altísimos y mantenimiento técnico impredecible que te hace depender de terceros.
					</p>

					<ul class="mt-6 space-y-3 border-t border-border-color pt-6">
						<li class="flex items-start gap-3">
							<span class="problem-chip" aria-hidden="true">
								<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
									<circle cx="12" cy="12" r="9"></circle>
									<path stroke-linecap="round" d="M12 7v5l3 2"></path>
								</svg>
							</span>
							<span class="text-[0.9375rem] leading-relaxed text-muted-strong">Meses de desarrollo antes de la primera venta</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="problem-chip" aria-hidden="true">
								<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V4h8a2 2 0 0 1 1.4.6l8.2 8.2a2 2 0 0 1 0 2.6Z"></path>
									<circle cx="7.5" cy="7.5" r="1.2"></circle>
								</svg>
							</span>
							<span class="text-[0.9375rem] leading-relaxed text-muted-strong">Miles de euros de inversión inicial</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="problem-chip" aria-hidden="true">
								<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
								</svg>
							</span>
							<span class="text-[0.9375rem] leading-relaxed text-muted-strong">Mantenimiento técnico continuo a tu cargo</span>
						</li>
					</ul>
				</div>

				<div class="problem-visual order-1 min-w-0 lg:order-1 lg:col-span-5">
					<div class="problem-stage">
						<span class="problem-ring" aria-hidden="true"></span>
						<span class="problem-orb" aria-hidden="true"></span>
						<Picture
							src={exhaustedDeveloper}
							formats={['avif', 'webp']}
							fallbackFormat="webp"
							width={1200}
							widths={[480, 720, 960, 1200]}
							sizes="(min-width: 1280px) 480px, (min-width: 1024px) 40vw, (min-width: 640px) 448px, 92vw"
							alt=""
							aria-hidden="true"
							loading="lazy"
							decoding="async"
							class="problem-art"
						/>
					</div>
				</div>
			</article>

			<!-- Escaparate cerrado: marketplace -->
			<article
				class="problem-row problem-row--violet problem-row--visual-end grid items-center gap-6 sm:gap-8 lg:grid-cols-12 lg:gap-10"
			>
				<div class="problem-card mk-card order-2 min-w-0 overflow-hidden p-6 sm:p-8 lg:order-1 lg:col-span-7">
					<span class="problem-label">
						<span class="problem-label-dot" aria-hidden="true"></span>
						Marketplaces
					</span>
					<h3 class="mt-4 font-display text-2xl font-bold tracking-[-0.01em] text-text-primary sm:text-[1.75rem]">
						Marketplaces Tradicionales
					</h3>
					<p class="mt-3 max-w-[62ch] text-base leading-relaxed text-text-secondary">
						Eres solo un vendedor más. Comisiones abusivas por venta, pérdida total de identidad de marca y nulo control sobre tus propios clientes (Amazon, MercadoLibre).
					</p>

					<ul class="mt-6 space-y-3 border-t border-border-color pt-6">
						<li class="flex items-start gap-3">
							<span class="problem-chip" aria-hidden="true">
								<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" d="M19 5 5 19"></path>
									<circle cx="6.5" cy="6.5" r="2.5"></circle>
									<circle cx="17.5" cy="17.5" r="2.5"></circle>
								</svg>
							</span>
							<span class="text-[0.9375rem] leading-relaxed text-muted-strong">Comisiones abusivas del 15% por venta</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="problem-chip" aria-hidden="true">
								<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
									<rect x="4" y="11" width="16" height="9" rx="2"></rect>
									<path stroke-linecap="round" d="M8 11V7a4 4 0 0 1 8 0v4"></path>
								</svg>
							</span>
							<span class="text-[0.9375rem] leading-relaxed text-muted-strong">Retención de fondos antes de cobrar</span>
						</li>
						<li class="flex items-start gap-3">
							<span class="problem-chip" aria-hidden="true">
								<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V4h8a2 2 0 0 1 1.4.6l8.2 8.2a2 2 0 0 1 0 2.6Z"></path>
									<path stroke-linecap="round" d="M4 4l16 16"></path>
								</svg>
							</span>
							<span class="text-[0.9375rem] leading-relaxed text-muted-strong">Sin identidad de marca propia</span>
						</li>
					</ul>
				</div>

				<div class="problem-visual order-1 min-w-0 lg:order-2 lg:col-span-5">
					<div class="problem-stage">
						<span class="problem-ring" aria-hidden="true"></span>
						<span class="problem-orb" aria-hidden="true"></span>
						<Picture
							src={marketplaceConfusion}
							formats={['avif', 'webp']}
							fallbackFormat="webp"
							width={1200}
							widths={[480, 720, 960, 1200]}
							sizes="(min-width: 1280px) 480px, (min-width: 1024px) 40vw, (min-width: 640px) 448px, 92vw"
							alt=""
							aria-hidden="true"
							loading="lazy"
							decoding="async"
							class="problem-art"
						/>
					</div>
				</div>
			</article>
		</div>

		<div class="problem-closing relative mt-12 text-center sm:mt-16">
			<div class="mx-auto h-px w-12 bg-linear-to-r from-transparent via-primary-mint to-transparent" aria-hidden="true"></div>
			<p class="mx-auto mt-6 max-w-3xl text-balance font-display text-xl font-semibold leading-snug tracking-[-0.01em] text-text-primary sm:text-2xl">
				Construir tu negocio no debería obligarte a elegir entre la ruina financiera o ceder tus márgenes.
			</p>
		</div>
	</div>
</section>

<style>
	.problem-row--mint {
		--problem-accent: var(--primary-turquoise);
		--problem-ink: var(--mint-ink);
	}

	.problem-row--violet {
		--problem-accent: var(--secondary-purple);
		--problem-ink: var(--violet-ink);
	}

	.problem-label {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		line-height: 1;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--problem-ink);
	}

	.problem-label-dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: var(--radius-full);
		background-color: var(--problem-accent);
	}

	.problem-card {
		--problem-card-border: color-mix(in srgb, var(--problem-accent) 22%, var(--border-color));
		--problem-glow-x: 100%;
		position: relative;
		border-color: var(--problem-card-border);
		background:
			radial-gradient(
				90% 70% at var(--problem-glow-x) 0%,
				color-mix(in srgb, var(--problem-accent) 9%, transparent),
				transparent 62%
			),
			var(--surface-raised);
		box-shadow:
			inset 0 1px 0 color-mix(in srgb, var(--problem-accent) 26%, transparent),
			0 24px 48px -32px color-mix(in srgb, var(--problem-accent) 45%, rgb(15 23 42 / 0.55)),
			var(--shadow-card);
	}

	/* El borde se marca en el lado que mira a la ilustración, solo en desktop. */
	@media (min-width: 1024px) {
		.problem-row--visual-start .problem-card {
			--problem-glow-x: 0%;
			border-inline-start-color: color-mix(in srgb, var(--problem-accent) 38%, var(--border-color));
		}

		.problem-row--visual-end .problem-card {
			border-inline-end-color: color-mix(in srgb, var(--problem-accent) 38%, var(--border-color));
		}
	}

	.problem-stage {
		position: relative;
		display: grid;
		place-items: center;
		overflow: hidden;
		min-height: 100%;
		padding: clamp(1.25rem, 4vw, 2.75rem);
		border: 1px solid color-mix(in srgb, var(--problem-accent) 20%, var(--border-color));
		border-radius: 1.5rem;
		background:
			radial-gradient(
				78% 68% at 50% 46%,
				color-mix(in srgb, var(--problem-accent) 10%, transparent),
				transparent 70%
			),
			linear-gradient(
				160deg,
				color-mix(in srgb, var(--problem-accent) 7%, var(--surface-raised)),
				var(--surface-sunken)
			);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / var(--card-edge-alpha));
	}

	.problem-stage :global(.problem-art) {
		position: relative;
		z-index: 1;
		width: 100%;
		height: auto;
		max-width: 28rem;
		filter: drop-shadow(0 18px 20px rgb(15 23 42 / 0.16));
	}

	.problem-ring {
		position: absolute;
		top: 8%;
		right: 9%;
		z-index: 0;
		width: clamp(3rem, 8vw, 4.5rem);
		height: clamp(3rem, 8vw, 4.5rem);
		border: 1px solid color-mix(in srgb, var(--problem-accent) 34%, transparent);
		border-radius: var(--radius-full);
		opacity: 0.7;
	}

	.problem-orb {
		position: absolute;
		bottom: 12%;
		left: 10%;
		z-index: 0;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: var(--radius-full);
		background-color: var(--problem-accent);
		opacity: 0.55;
	}

	.problem-row--visual-end .problem-ring {
		right: auto;
		left: 9%;
	}

	.problem-row--visual-end .problem-orb {
		left: auto;
		right: 10%;
	}

	.problem-chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: none;
		width: 2rem;
		height: 2rem;
		border: 1px solid color-mix(in srgb, var(--problem-accent) 18%, var(--border-color));
		border-radius: 0.625rem;
		background-color: color-mix(in srgb, var(--problem-accent) 10%, var(--surface-raised));
		color: var(--problem-ink);
	}

	.problem-closing {
		isolation: isolate;
	}

	.problem-closing::before {
		content: '';
		position: absolute;
		z-index: -1;
		inset: -1.5rem 8% -1rem;
		pointer-events: none;
		background: radial-gradient(
			55% 65% at 50% 50%,
			color-mix(in srgb, var(--primary-mint) 9%, transparent),
			transparent 72%
		);
	}

	:global(:root[data-theme='dark']) .problem-card {
		--problem-card-border: color-mix(in srgb, var(--problem-accent) 30%, var(--border-color));
		background:
			radial-gradient(
				100% 80% at var(--problem-glow-x) 0%,
				color-mix(in srgb, var(--problem-accent) 12%, transparent),
				transparent 60%
			),
			var(--surface-raised);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.06),
			0 30px 55px -30px rgb(0 0 0 / 0.75),
			var(--shadow-card);
	}

	:global(:root[data-theme='dark']) .problem-stage {
		background:
			radial-gradient(
				72% 62% at 50% 46%,
				color-mix(in srgb, var(--problem-accent) 16%, transparent),
				transparent 70%
			),
			var(--surface-sunken);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
	}

	:global(:root[data-theme='dark']) .problem-stage :global(.problem-art) {
		filter: drop-shadow(0 22px 28px rgb(0 0 0 / 0.5));
	}

</style>
